{
  "name": "meeting-intelligence",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "node --env-file-if-exists=.env server/src/server.ts",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "lint": "oxlint -c .oxlintrc.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
